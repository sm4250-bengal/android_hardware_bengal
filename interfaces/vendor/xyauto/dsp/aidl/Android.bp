package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aidl_interface {
    name: "vendor.xyauto.dsp",
    vendor_available: true,
    srcs: ["vendor/xyauto/dsp/*.aidl"],
    stability: "vintf",
    frozen: true,

    backend: {
        rust: {
            enabled: true,
        },
        ndk: {
            enabled: true,
        },
        java: {
            enabled: true,
            platform_apis: true,
        },
        cpp: {
            enabled: false,
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
        {
            version: "2",
            imports: [],
        },
        {
            version: "3",
            imports: [],
        },
        {
            version: "4",
            imports: [],
        },

    ],
}
