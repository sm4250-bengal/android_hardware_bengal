// SPDX-License-Identifier: Apache-2.0
cc_binary {
    name: "android.hardware.thermal-service.bengal",
    vendor: true,
    relative_install_path: "hw",
    srcs: ["service.cpp", "ThermalSensors.cpp"],
    cpp_std: "c++17",
    cflags: ["-Wall", "-Wextra", "-Werror"],
    shared_libs: ["android.hardware.thermal-V3-ndk", "libbinder_ndk"],
    // device.mk copies the RC content; init_rc preserves the mirror's host symlink.
    vintf_fragments: ["thermal-bengal.xml"],
}
